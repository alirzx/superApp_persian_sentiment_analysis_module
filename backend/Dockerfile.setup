FROM python:3.11-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
ARG PIP_PRIMARY_INDEX_URL=https://package-mirror.liara.ir/repository/pypi/simple
ARG PIP_FALLBACK_INDEX_URL=https://mirror2.chabokan.net/pypi/simple/
ARG PIP_TIMEOUT_SECONDS=90
ARG PIP_RETRIES=4
WORKDIR /app
COPY backend/requirements.txt backend/requirements-setup.txt /tmp/
# Download ONLY the CPU-specific torch wheel from the official PyTorch CPU index.
# Install that local wheel and ALL Python dependencies using Liara or Chabokan.
# No pip index/extra-index points to pypi.org; --isolated ignores user pip config.
RUN set -eu; \
    mkdir -p /tmp/torch-wheels; \
    python -m pip --isolated download --disable-pip-version-check --no-cache-dir \
      --timeout "$PIP_TIMEOUT_SECONDS" --retries "$PIP_RETRIES" --no-deps \
      --index-url https://download.pytorch.org/whl/cpu \
      --dest /tmp/torch-wheels 'torch==2.5.1+cpu'; \
    (python -m pip --isolated install --disable-pip-version-check --no-cache-dir \
       --timeout "$PIP_TIMEOUT_SECONDS" --retries "$PIP_RETRIES" \
       --index-url "$PIP_PRIMARY_INDEX_URL" \
       /tmp/torch-wheels/torch-*.whl -r /tmp/requirements-setup.txt || \
     python -m pip --isolated install --disable-pip-version-check --no-cache-dir \
       --timeout "$PIP_TIMEOUT_SECONDS" --retries "$PIP_RETRIES" \
       --index-url "$PIP_FALLBACK_INDEX_URL" \
       /tmp/torch-wheels/torch-*.whl -r /tmp/requirements-setup.txt); \
    rm -rf /tmp/torch-wheels
COPY backend/app /app/app
COPY backend/scripts /app/scripts
COPY models.json /app/models.json
CMD ["python", "-m", "scripts.prepare_models"]
