# Production requires a *real* random API_TOKEN; blank fails startup intentionally.
# Generate privately (not in Git): openssl rand -hex 32
# Do not expose UI publicly without authenticated HTTPS ingress and rate limiting.
# Initial model preparation may use main, but pin both MODEL_*_REVISION values to the
# exact 40-char SHAs from generated manifests before production service rollout.
APP_ENV=production
API_TOKEN=
API_BIND_IP=127.0.0.1
API_PORT=8002
# LAN and VPN interface binding. Restrict TCP/8083 to trusted networks with firewall/VPN.
# This UI proxies the service API token; add user authentication before wider access.
UI_BIND_IP=0.0.0.0
UI_PORT=8083
PIP_PRIMARY_INDEX_URL=https://package-mirror.liara.ir/repository/pypi/simple
PIP_FALLBACK_INDEX_URL=https://mirror2.chabokan.net/pypi/simple/
PIP_TIMEOUT_SECONDS=90
PIP_RETRIES=4
NPM_REGISTRY_URL=https://package-mirror.liara.ir/repository/npm/
HF_HUB_ETAG_TIMEOUT=30
HF_HUB_DOWNLOAD_TIMEOUT=120
# main is resolved to a SHA at first prepare and then locked in the persistent manifest.
MODEL_SENTIMENT_REVISION=main
MODEL_TOPICS_REVISION=main
CPU_THREADS=2
MAX_CONCURRENT_INFERENCE=1
MAX_QUEUE_WAIT_SECONDS=10
MAX_TEXT_CHARS=5000
MAX_BATCH_ITEMS=16
MAX_REQUEST_BYTES=65536
API_CPUS=2.0
API_MEMORY=1200m
UI_CPUS=0.5
UI_MEMORY=256m
SETUP_CPUS=3.0
SETUP_MEMORY=4g
ENABLE_METRICS=true
